<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update task</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('navbar') %>

  


     <div class="container">
          <h1>Update Task Page</h1>
          <form class="todo-form" action="/update/<%= result._id %>" method="post">
            <input value="<%= result.title %>" class="input" type="text" placeholder="Enter Task title" name="title">
            <br>
            <br>
            <textarea class="input" name="description" id=""><%= result.description %></textarea>
            <br><br>
            <button class="btn" type="submit">Add New Task</button>

        </form>
    </div>

  </body>
</html>
